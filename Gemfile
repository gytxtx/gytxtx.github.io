source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "jekyll-remote-theme"

# Ruby 3.4+ no longer ships these as default loaded libraries, while the
# GitHub Pages Jekyll stack still requires them at runtime.
gem "bigdecimal"
gem "csv"
gem "webrick"

# Windows file watcher for `jekyll serve`.
gem "wdm", ">= 0.1.0", platforms: [:windows]
